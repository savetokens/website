---
import Layout from '../../layouts/Layout.astro';
import InteractiveDemo from '../../components/InteractiveDemo.astro';
import CodeExamples from '../../components/CodeExamples.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import Features from '../../components/Features.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="AXON - Adaptive eXchange Oriented Notation | SaveTokens">
  <!-- Hero Section -->
  <section class="min-h-[90vh] flex items-center justify-center px-4 py-20 pt-28 relative overflow-hidden">
    <!-- Ambient background -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 -left-32 w-[400px] h-[400px] bg-accent-200/15 dark:bg-accent-800/8 rounded-full blur-[100px]"></div>
      <div class="absolute bottom-1/4 -right-32 w-[400px] h-[400px] bg-primary-200/15 dark:bg-primary-800/8 rounded-full blur-[100px]"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-highlight-200/10 dark:bg-highlight-800/5 rounded-full blur-[120px]"></div>
    </div>

    <div class="max-w-5xl mx-auto text-center relative z-10">
      <!-- Breadcrumb -->
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-[13px] text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          SaveTokens
        </a>
      </div>

      <!-- Main Headline -->
      <h1 class="text-[3.5rem] md:text-[5rem] lg:text-[5.5rem] font-bold leading-[1.05] tracking-tight mb-6">
        <span class="bg-gradient-to-r from-gray-900 via-primary-700 to-gray-900 dark:from-gray-100 dark:via-primary-300 dark:to-gray-100 bg-clip-text text-transparent">AXON</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-gray-400 dark:text-gray-500 mb-4 font-light tracking-widest uppercase">
        Adaptive eXchange Oriented Notation
      </p>

      <!-- Description -->
      <p class="text-lg text-gray-500 dark:text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed font-light">
        A data serialization format built for LLMs. Feed it JSON, XML, or any verbose format.
        AXON produces compact, typed, validated output that cuts token costs up to 95% while preserving every bit of meaning.
      </p>

      <!-- Install command -->
      <div class="inline-flex items-center gap-3 px-5 py-3 bg-gray-900 dark:bg-gray-800 rounded-xl mb-10 shadow-lg">
        <span class="text-[13px] text-gray-400 font-mono">$</span>
        <code class="text-[13px] text-gray-100 font-mono">npm install @axon-format/core</code>
        <button
          id="copy-install"
          class="text-gray-500 hover:text-gray-300 transition-colors ml-1"
          aria-label="Copy install command"
        >
          <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
          </svg>
          <svg id="check-icon" class="w-4 h-4 hidden text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-16">
        <a
          href="/axon/docs"
          class="group px-7 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-semibold text-[15px] hover:bg-gray-800 dark:hover:bg-gray-100 transition-all duration-200 shadow-lg shadow-gray-900/10 dark:shadow-black/20 hover:shadow-xl hover:-translate-y-0.5 flex items-center gap-2"
        >
          Read the Docs
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <a
          href="https://github.com/savetokens/axon"
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-3.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700 rounded-xl font-semibold text-[15px] hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-200 flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
          View Source
        </a>
        <a
          href="#demo"
          class="px-7 py-3.5 text-gray-500 dark:text-gray-400 font-medium text-[15px] hover:text-gray-900 dark:hover:text-gray-100 transition-colors flex items-center gap-2"
        >
          Try the Demo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>

      <!-- Key Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <div class="relative p-5 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-2xl border border-gray-200/60 dark:border-gray-700/60 group hover:border-green-300 dark:hover:border-green-700 transition-all duration-300">
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-green-400/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="text-3xl font-bold bg-gradient-to-br from-green-600 to-primary-600 dark:from-green-400 dark:to-primary-400 bg-clip-text text-transparent mb-1">60&ndash;95%</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Lower token costs</div>
        </div>
        <div class="relative p-5 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-2xl border border-gray-200/60 dark:border-gray-700/60 group hover:border-blue-300 dark:hover:border-blue-700 transition-all duration-300">
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue-400/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="text-3xl font-bold bg-gradient-to-br from-blue-600 to-primary-600 dark:from-blue-400 dark:to-primary-400 bg-clip-text text-transparent mb-1">13</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Validated types for data quality</div>
        </div>
        <div class="relative p-5 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-2xl border border-gray-200/60 dark:border-gray-700/60 group hover:border-accent-300 dark:hover:border-accent-700 transition-all duration-300">
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-400/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="text-3xl font-bold bg-gradient-to-br from-accent-600 to-primary-600 dark:from-accent-400 dark:to-primary-400 bg-clip-text text-transparent mb-1">204x</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Compression for repeated patterns</div>
        </div>
        <div class="relative p-5 bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-2xl border border-gray-200/60 dark:border-gray-700/60 group hover:border-highlight-300 dark:hover:border-highlight-700 transition-all duration-300">
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-highlight-400/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="text-3xl font-bold bg-gradient-to-br from-highlight-600 to-primary-600 dark:from-highlight-400 dark:to-primary-400 bg-clip-text text-transparent mb-1">342</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">Tests passing (93% coverage)</div>
        </div>
      </div>
    </div>
  </section>

  <InteractiveDemo />
  <CodeExamples />
  <CostCalculator />
  <Features />

  <!-- Documentation CTA -->
  <section class="py-28 px-4 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-accent-50 dark:from-primary-950/20 dark:via-gray-900 dark:to-accent-950/20"></div>
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-300/30 to-transparent"></div>

    <div class="max-w-3xl mx-auto text-center relative z-10">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="text-gray-900 dark:text-gray-100">Ready to </span>
        <span class="bg-gradient-to-r from-primary-600 to-highlight-600 dark:from-primary-400 dark:to-highlight-400 bg-clip-text text-transparent">Dive Deeper?</span>
      </h2>
      <p class="text-lg text-gray-500 dark:text-gray-400 mb-10 max-w-xl mx-auto leading-relaxed">
        Type system reference, compression algorithms, schema validation, encoding modes, and real-world examples. All in one place.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/axon/docs"
          class="group inline-flex items-center gap-2 px-7 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-semibold text-[15px] hover:bg-gray-800 dark:hover:bg-gray-100 transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
        >
          View Documentation
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <a
          href="/axon/docs/quick-start"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-gray-600 dark:text-gray-300 font-medium text-[15px] hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
        >
          Quick Start Guide
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    const copyBtn = document.getElementById('copy-install');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');

    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText('npm install @axon-format/core');
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    });
  </script>
</Layout>
