<section id="demo" class="py-20 px-4 bg-gray-50 dark:bg-gray-800">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">See the Difference</h2>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-3">
        Paste your JSON or XML data and watch AXON compress it in real-time
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-500 italic">
        Note: This is a conceptual demonstration. Real AXON uses binary encoding and is more sophisticated.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- Input -->
      <div class="bg-white dark:bg-gray-900 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gray-900 dark:bg-gray-950 text-white px-4 py-3 flex justify-between items-center">
          <span id="input-label" class="font-semibold">JSON Input</span>
          <span id="json-tokens" class="text-sm text-gray-400">0 tokens</span>
        </div>
        <textarea
          id="json-input"
          class="w-full h-80 p-4 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-mono text-sm resize-none focus:outline-none"
          placeholder='{"users": [{"name": "Alice", "age": 30}, {"name": "Bob", "age": 30}]}'
        ></textarea>
      </div>

      <!-- AXON Output -->
      <div class="bg-white dark:bg-gray-900 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gray-900 dark:bg-gray-950 text-white px-4 py-3 flex justify-between items-center">
          <span class="font-semibold">AXON Output</span>
          <span id="axon-tokens" class="text-sm text-green-400">0 tokens</span>
        </div>
        <pre
          id="axon-output"
          class="w-full h-80 p-4 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-mono text-sm overflow-auto"
        >AXON output will appear here...</pre>
      </div>
    </div>

    <!-- Savings Display -->
    <div class="mt-8 p-6 bg-white dark:bg-gray-900 rounded-lg shadow-lg text-center">
      <div class="text-3xl font-bold mb-2">
        <span id="savings-percentage" class="text-green-600 dark:text-green-400">0%</span>
        <span class="text-gray-600 dark:text-gray-400 text-xl ml-2">Token Savings</span>
      </div>
      <div class="text-gray-500 dark:text-gray-500">
        <span id="tokens-saved">0</span> tokens saved with AXON
      </div>
    </div>

    <!-- Example Buttons -->
    <div class="mt-6 flex flex-wrap gap-3 justify-center">
      <button
        class="example-btn px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        data-example='{"users": [{"id": 1001, "name": "Alice Chen", "email": "alice@company.com", "role": "admin", "department": "Engineering", "active": true, "verified": true}, {"id": 1002, "name": "Bob Smith", "email": "bob@company.com", "role": "user", "department": "Engineering", "active": true, "verified": true}, {"id": 1003, "name": "Carol Johnson", "email": "carol@company.com", "role": "user", "department": "Engineering", "active": true, "verified": true}, {"id": 1004, "name": "David Lee", "email": "david@company.com", "role": "user", "department": "Engineering", "active": true, "verified": false}, {"id": 1005, "name": "Eva Martinez", "email": "eva@company.com", "role": "user", "department": "Sales", "active": true, "verified": true}, {"id": 1006, "name": "Frank Wilson", "email": "frank@company.com", "role": "user", "department": "Sales", "active": true, "verified": true}, {"id": 1007, "name": "Grace Kim", "email": "grace@company.com", "role": "manager", "department": "Sales", "active": true, "verified": true}, {"id": 1008, "name": "Henry Brown", "email": "henry@company.com", "role": "user", "department": "Marketing", "active": false, "verified": true}]}'
      >
        API Response
      </button>
      <button
        class="example-btn px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        data-example='{"events": [{"timestamp": 1706745600, "userId": "u_8x7k2", "event": "page_view", "page": "/dashboard", "duration": 45}, {"timestamp": 1706745601, "userId": "u_8x7k2", "event": "click", "page": "/dashboard", "duration": 2}, {"timestamp": 1706745602, "userId": "u_8x7k2", "event": "page_view", "page": "/settings", "duration": 30}, {"timestamp": 1706745603, "userId": "u_8x7k2", "event": "click", "page": "/settings", "duration": 1}, {"timestamp": 1706745604, "userId": "u_8x7k2", "event": "page_view", "page": "/profile", "duration": 60}, {"timestamp": 1706745605, "userId": "u_8x7k2", "event": "click", "page": "/profile", "duration": 3}, {"timestamp": 1706745606, "userId": "u_8x7k2", "event": "page_view", "page": "/billing", "duration": 90}, {"timestamp": 1706745607, "userId": "u_8x7k2", "event": "click", "page": "/billing", "duration": 5}, {"timestamp": 1706745608, "userId": "u_8x7k2", "event": "purchase", "page": "/billing", "duration": 120}, {"timestamp": 1706745609, "userId": "u_8x7k2", "event": "page_view", "page": "/confirmation", "duration": 15}]}'
      >
        Analytics Events
      </button>
      <button
        class="example-btn px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        data-example='{"products": [{"sku": "LAPTOP-001", "name": "MacBook Pro 14\"", "price": 1999.00, "category": "Electronics", "inStock": true, "rating": 4.8}, {"sku": "LAPTOP-002", "name": "MacBook Air M3", "price": 1299.00, "category": "Electronics", "inStock": true, "rating": 4.7}, {"sku": "LAPTOP-003", "name": "Dell XPS 15", "price": 1799.00, "category": "Electronics", "inStock": true, "rating": 4.5}, {"sku": "PHONE-001", "name": "iPhone 15 Pro", "price": 999.00, "category": "Electronics", "inStock": true, "rating": 4.6}, {"sku": "PHONE-002", "name": "Samsung Galaxy S24", "price": 899.00, "category": "Electronics", "inStock": false, "rating": 4.4}, {"sku": "TABLET-001", "name": "iPad Pro 12.9\"", "price": 1099.00, "category": "Electronics", "inStock": true, "rating": 4.9}, {"sku": "WATCH-001", "name": "Apple Watch Ultra", "price": 799.00, "category": "Electronics", "inStock": true, "rating": 4.7}, {"sku": "AUDIO-001", "name": "AirPods Pro 2", "price": 249.00, "category": "Electronics", "inStock": true, "rating": 4.8}]}'
      >
        Product Catalog
      </button>
      <button
        class="example-btn px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        data-example='{"messages": [{"role": "system", "content": "You are a helpful coding assistant.", "timestamp": 1706745600}, {"role": "user", "content": "How do I read a file in Python?", "timestamp": 1706745610}, {"role": "assistant", "content": "You can use the open() function with a context manager.", "timestamp": 1706745615}, {"role": "user", "content": "Can you show me an example?", "timestamp": 1706745625}, {"role": "assistant", "content": "Here is an example using with open()...", "timestamp": 1706745630}, {"role": "user", "content": "What about writing to a file?", "timestamp": 1706745650}, {"role": "assistant", "content": "For writing, use open() with mode w or a.", "timestamp": 1706745655}, {"role": "user", "content": "How do I handle encoding?", "timestamp": 1706745670}, {"role": "assistant", "content": "Pass encoding parameter like encoding=utf-8.", "timestamp": 1706745675}, {"role": "user", "content": "Thanks, that helps!", "timestamp": 1706745690}, {"role": "assistant", "content": "You are welcome! Let me know if you need more help.", "timestamp": 1706745695}]}'
      >
        Chat History
      </button>
      <button
        class="example-btn xml-example px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
        data-example='<?xml version="1.0" encoding="UTF-8"?>
<catalog>
  <product id="P001" category="electronics">
    <name>Wireless Headphones</name>
    <price currency="USD">149.99</price>
    <stock>250</stock>
    <rating>4.5</rating>
  </product>
  <product id="P002" category="electronics">
    <name>Bluetooth Speaker</name>
    <price currency="USD">79.99</price>
    <stock>180</stock>
    <rating>4.2</rating>
  </product>
  <product id="P003" category="electronics">
    <name>USB-C Hub</name>
    <price currency="USD">45.00</price>
    <stock>320</stock>
    <rating>4.7</rating>
  </product>
  <product id="P004" category="accessories">
    <name>Phone Case</name>
    <price currency="USD">25.00</price>
    <stock>500</stock>
    <rating>4.0</rating>
  </product>
  <product id="P005" category="accessories">
    <name>Screen Protector</name>
    <price currency="USD">15.00</price>
    <stock>750</stock>
    <rating>4.3</rating>
  </product>
</catalog>'
        data-type="xml"
      >
        Try: XML Data
      </button>
    </div>
  </div>
</section>

<script>
  // Track current input type
  let currentInputType: 'json' | 'xml' = 'json';

  // Simple token counter (approximates GPT tokenization)
  function countTokens(text: string): number {
    // Rough approximation: ~4 characters per token
    return Math.ceil(text.length / 4);
  }

  // Detect if input is XML
  function isXml(text: string): boolean {
    const trimmed = text.trim();
    return trimmed.startsWith('<?xml') || trimmed.startsWith('<');
  }

  // Simplified AXON encoder for JSON demo purposes
  function convertJsonToAxon(jsonObj: any): string {
    // NOTE: This is a conceptual demonstration, not the actual AXON format
    // Real AXON uses binary encoding and is more sophisticated

    // Handle objects with array values (like {"users": [...]})
    if (typeof jsonObj === 'object' && !Array.isArray(jsonObj)) {
      let result = '';
      for (const [key, value] of Object.entries(jsonObj)) {
        if (Array.isArray(value)) {
          result += `${key}:` + convertJsonToAxon(value) + '\n';
        } else {
          result += `${key}:${JSON.stringify(value)}\n`;
        }
      }
      return result.trim();
    }

    if (Array.isArray(jsonObj)) {
      const firstItem = jsonObj[0];
      if (typeof firstItem === 'object' && firstItem !== null) {
        // Columnar representation
        const keys = Object.keys(firstItem);
        let axon = `@schema(${keys.join(',')})\n`;

        for (const key of keys) {
          const values = jsonObj.map(item => item[key]);

          // Check if all values are the same (RLE compression)
          const allSame = values.every(v => v === values[0]);
          if (allSame) {
            axon += `  ${key}:${JSON.stringify(values[0])}*${values.length}\n`;
          } else if (values.every(v => typeof v === 'number')) {
            // All numbers - check for sequential pattern
            const deltas = [];
            let isGoodPattern = true;

            for (let i = 1; i < values.length; i++) {
              const current = values[i];
              const previous = values[i-1];
              if (current !== undefined && previous !== undefined) {
                const delta = current - previous;
                // Round to avoid floating point errors
                const roundedDelta = Math.round(delta * 100) / 100;
                deltas.push(roundedDelta);

                // If deltas vary too much, not a good pattern
                if (Math.abs(roundedDelta) > 10) {
                  isGoodPattern = false;
                  break;
                }
              }
            }

            // Check if deltas are consistent (good for delta encoding)
            const deltaSet = new Set(deltas);
            if (isGoodPattern && deltaSet.size <= 2) {
              // Use delta encoding
              axon += `  ${key}:Δ${values[0]}[${deltas.join(',')}]\n`;
            } else {
              // Just list the values (still more compact than JSON objects)
              axon += `  ${key}:[${values.join(',')}]\n`;
            }
          } else {
            // Mixed types or strings - just list them
            axon += `  ${key}:[${values.map(v => JSON.stringify(v)).join(',')}]\n`;
          }
        }
        return axon;
      } else if (typeof firstItem === 'boolean') {
        // Bit packing for booleans
        const bits = jsonObj.map((b: boolean) => b ? '1' : '0').join('');
        return `@bitpack(${jsonObj.length}):0b${bits}`;
      } else {
        return `[${jsonObj.join(',')}]`;
      }
    }

    return JSON.stringify(jsonObj);
  }

  // Simple XML parser for demo (extracts structure)
  interface XmlElement {
    name: string;
    attrs: Record<string, string>;
    children: (XmlElement | string)[];
  }

  function parseXmlSimple(xml: string): XmlElement | null {
    // Remove XML declaration
    const content = xml.replace(/<\?xml[^?]*\?>/g, '').trim();

    // Simple recursive parser
    function parseElement(str: string, startIdx: number): { element: XmlElement | null; endIdx: number } {
      // Skip whitespace
      while (startIdx < str.length && /\s/.test(str.charAt(startIdx))) startIdx++;

      if (startIdx >= str.length || str.charAt(startIdx) !== '<') {
        return { element: null, endIdx: startIdx };
      }

      // Find tag name
      let idx = startIdx + 1;
      let tagName = '';
      while (idx < str.length && /[a-zA-Z0-9_:-]/.test(str.charAt(idx))) {
        tagName += str.charAt(idx);
        idx++;
      }

      if (!tagName) return { element: null, endIdx: startIdx };

      // Parse attributes
      const attrs: Record<string, string> = {};
      while (idx < str.length && str.charAt(idx) !== '>' && str.charAt(idx) !== '/') {
        // Skip whitespace
        while (idx < str.length && /\s/.test(str.charAt(idx))) idx++;
        if (str.charAt(idx) === '>' || str.charAt(idx) === '/') break;

        // Get attribute name
        let attrName = '';
        while (idx < str.length && /[a-zA-Z0-9_:-]/.test(str.charAt(idx))) {
          attrName += str.charAt(idx);
          idx++;
        }

        if (attrName && str.charAt(idx) === '=') {
          idx++; // skip =
          const quote = str.charAt(idx);
          if (quote === '"' || quote === "'") {
            idx++; // skip opening quote
            let attrValue = '';
            while (idx < str.length && str.charAt(idx) !== quote) {
              attrValue += str.charAt(idx);
              idx++;
            }
            idx++; // skip closing quote
            attrs[attrName] = attrValue;
          }
        }
      }

      // Self-closing tag
      if (str.charAt(idx) === '/') {
        idx += 2; // skip />
        return {
          element: { name: tagName, attrs, children: [] },
          endIdx: idx
        };
      }

      idx++; // skip >

      // Parse children
      const children: (XmlElement | string)[] = [];
      let textContent = '';

      while (idx < str.length) {
        // Skip whitespace for structure
        while (idx < str.length && /\s/.test(str.charAt(idx))) idx++;

        if (idx >= str.length) break;

        // Check for closing tag
        if (str.substring(idx, idx + 2 + tagName.length + 1) === `</${tagName}>`) {
          if (textContent.trim()) {
            children.push(textContent.trim());
          }
          idx += 2 + tagName.length + 1;
          break;
        }

        // Check for child element
        if (str.charAt(idx) === '<' && str.charAt(idx + 1) !== '/') {
          if (textContent.trim()) {
            children.push(textContent.trim());
            textContent = '';
          }
          const result = parseElement(str, idx);
          if (result.element) {
            children.push(result.element);
            idx = result.endIdx;
          } else {
            break;
          }
        } else if (str.charAt(idx) !== '<') {
          // Text content
          while (idx < str.length && str.charAt(idx) !== '<') {
            textContent += str.charAt(idx);
            idx++;
          }
        } else {
          break;
        }
      }

      return {
        element: { name: tagName, attrs, children },
        endIdx: idx
      };
    }

    const result = parseElement(content, 0);
    return result.element;
  }

  // Convert XML to AXON format
  function convertXmlToAxon(xmlString: string): string {
    const root = parseXmlSimple(xmlString);
    if (!root) return 'Invalid XML';

    let result = `@xml\n`;

    function processElement(el: XmlElement, indent: string = ''): string {
      let out = `${indent}${el.name}`;

      // Add attributes inline
      const attrEntries = Object.entries(el.attrs);
      if (attrEntries.length > 0) {
        const attrStr = attrEntries.map(([k, v]) => `@${k}:${JSON.stringify(v)}`).join(' ');
        out += ` {${attrStr}}`;
      }

      // Check if children are uniform elements (same tag name)
      const elementChildren = el.children.filter((c): c is XmlElement => typeof c !== 'string');
      const textChildren = el.children.filter((c): c is string => typeof c === 'string');

      if (elementChildren.length > 1) {
        const firstChild = elementChildren[0];
        if (firstChild) {
          const firstChildName = firstChild.name;
          const allSameName = elementChildren.every(c => c.name === firstChildName);

          if (allSameName && elementChildren.length >= 2) {
            // Use columnar/schema format for uniform children
            out += `:\n`;

            // Get all unique attribute and child element names
            const allAttrs = new Set<string>();
            const allChildElements = new Set<string>();

            for (const child of elementChildren) {
              Object.keys(child.attrs).forEach(a => allAttrs.add(a));
              child.children.forEach(c => {
                if (typeof c !== 'string') allChildElements.add(c.name);
              });
            }

            const schemaFields = [...allAttrs].map(a => `@${a}`).concat([...allChildElements]);
            out += `${indent}  @schema(${firstChildName}): [${schemaFields.join(', ')}]\n`;

            // Extract column values
            const columns: Record<string, string[]> = {};
            schemaFields.forEach(f => { columns[f] = []; });

            for (const child of elementChildren) {
              for (const attr of allAttrs) {
                const col = columns[`@${attr}`];
                if (col) col.push(child.attrs[attr] || '');
              }
              for (const elemName of allChildElements) {
                const found = child.children.find((c): c is XmlElement =>
                  typeof c !== 'string' && c.name === elemName
                );
                const textVal = found?.children.find((c): c is string => typeof c === 'string') || '';
                const col = columns[elemName];
                if (col) col.push(textVal);
              }
            }

            // Output columns with compression
            for (const [field, values] of Object.entries(columns)) {
              // Check for repeated values (RLE)
              const firstVal = values[0];
              const allSame = values.every(v => v === firstVal);
              if (allSame && firstVal) {
                out += `${indent}    ${field}: ${JSON.stringify(firstVal)}*${values.length}\n`;
              } else {
                // Check for dictionary compression opportunity
                const unique = [...new Set(values)];
                if (unique.length <= 3 && values.length > 3) {
                  out += `${indent}    ${field}: @dict(${unique.map(u => JSON.stringify(u)).join(',')})[${values.map(v => unique.indexOf(v)).join(',')}]\n`;
                } else {
                  out += `${indent}    ${field}: [${values.map(v => JSON.stringify(v)).join(', ')}]\n`;
                }
              }
            }
            return out;
          }
        }
      }

      // Non-uniform children or mixed content
      if (el.children.length === 0) {
        out += '\n';
      } else if (textChildren.length === 1 && elementChildren.length === 0) {
        out += `: ${JSON.stringify(textChildren[0])}\n`;
      } else {
        out += ':\n';
        for (const child of el.children) {
          if (typeof child === 'string') {
            out += `${indent}  _text: ${JSON.stringify(child)}\n`;
          } else {
            out += processElement(child, indent + '  ');
          }
        }
      }

      return out;
    }

    result += processElement(root);
    return result;
  }

  function updateInputLabel(type: 'json' | 'xml') {
    const label = document.getElementById('input-label');
    if (label) {
      label.textContent = type === 'xml' ? 'XML Input' : 'JSON Input';
    }
    currentInputType = type;
  }

  function updateDemo() {
    const input = document.getElementById('json-input') as HTMLTextAreaElement;
    const output = document.getElementById('axon-output') as HTMLPreElement;
    const jsonTokensEl = document.getElementById('json-tokens');
    const axonTokensEl = document.getElementById('axon-tokens');
    const savingsPercentageEl = document.getElementById('savings-percentage');
    const tokensSavedEl = document.getElementById('tokens-saved');

    try {
      const inputText = input.value.trim();
      if (!inputText) {
        output.textContent = 'AXON output will appear here...';
        if (jsonTokensEl) jsonTokensEl.textContent = '0 tokens';
        if (axonTokensEl) axonTokensEl.textContent = '0 tokens';
        if (savingsPercentageEl) savingsPercentageEl.textContent = '0%';
        if (tokensSavedEl) tokensSavedEl.textContent = '0';
        return;
      }

      let axonText: string;

      if (isXml(inputText)) {
        updateInputLabel('xml');
        axonText = convertXmlToAxon(inputText);
      } else {
        updateInputLabel('json');
        const jsonObj = JSON.parse(inputText);
        axonText = convertJsonToAxon(jsonObj);
      }

      const inputTokens = countTokens(inputText);
      const axonTokens = countTokens(axonText);
      const savedTokens = Math.max(0, inputTokens - axonTokens);
      const savingsPercent = inputTokens > 0
        ? Math.round((savedTokens / inputTokens) * 100)
        : 0;

      output.classList.remove('text-red-400');
      output.textContent = axonText;
      if (jsonTokensEl) jsonTokensEl.textContent = `${inputTokens} tokens`;
      if (axonTokensEl) axonTokensEl.textContent = `${axonTokens} tokens`;
      if (savingsPercentageEl) savingsPercentageEl.textContent = `${savingsPercent}%`;
      if (tokensSavedEl) tokensSavedEl.textContent = savedTokens.toString();
    } catch (e) {
      const errorMsg = currentInputType === 'xml'
        ? 'Invalid XML - please check your syntax'
        : 'Invalid JSON - please check your syntax';
      output.textContent = errorMsg;
      output.classList.add('text-red-400');
    }
  }

  // Event listeners
  const input = document.getElementById('json-input') as HTMLTextAreaElement;
  if (input) {
    input.addEventListener('input', updateDemo);
  }

  // Example buttons
  document.querySelectorAll('.example-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.target as HTMLButtonElement;
      const example = target.dataset.example;
      const type = target.dataset.type;

      if (example && input) {
        if (type === 'xml') {
          // XML example - use as-is
          input.value = example;
          updateInputLabel('xml');
        } else {
          // JSON example - format it
          input.value = JSON.stringify(JSON.parse(example), null, 2);
          updateInputLabel('json');
        }
        updateDemo();
      }
    });
  });

  // Load first example on page load
  window.addEventListener('load', () => {
    const firstExample = document.querySelector('.example-btn') as HTMLButtonElement;
    if (firstExample && input) {
      const example = firstExample.dataset.example;
      if (example) {
        input.value = JSON.stringify(JSON.parse(example), null, 2);
        updateDemo();
      }
    }
  });
</script>
