---
const currentPath = Astro.url.pathname;

const sections = [
  {
    title: 'Getting Started',
    icon: 'rocket',
    links: [
      { href: '/axon/docs', label: 'Overview' },
      { href: '/axon/docs/installation', label: 'Installation' },
      { href: '/axon/docs/quick-start', label: 'Quick Start' },
    ]
  },
  {
    title: 'Core Concepts',
    icon: 'cube',
    links: [
      { href: '/axon/docs/type-system', label: 'Type System' },
      { href: '/axon/docs/compression', label: 'Compression' },
      { href: '/axon/docs/encoding-modes', label: 'Encoding Modes' },
    ]
  },
  {
    title: 'Advanced',
    icon: 'bolt',
    links: [
      { href: '/axon/docs/schemas', label: 'Schema System' },
      { href: '/axon/docs/query-hints', label: 'Query Hints' },
      { href: '/axon/docs/performance', label: 'Performance' },
    ]
  },
  {
    title: 'Resources',
    icon: 'book',
    links: [
      { href: '/axon/docs/best-practices', label: 'Best Practices' },
      { href: '/axon/docs/examples', label: 'Examples' },
    ]
  }
];

// Page order for progress indicator
const allPages = sections.flatMap(s => s.links.map(l => l.href));
const currentIndex = allPages.indexOf(currentPath);
const totalPages = allPages.length;
---

<aside class="w-64 flex-shrink-0 sticky top-24 self-start hidden lg:block">
  <nav class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
    <!-- Progress bar at top -->
    {currentIndex >= 0 && (
      <div class="px-6 pt-5 pb-3">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500">Progress</span>
          <span class="text-[10px] font-mono text-gray-400 dark:text-gray-500">{currentIndex + 1}/{totalPages}</span>
        </div>
        <div class="w-full h-1.5 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
          <div
            class="h-full bg-gradient-to-r from-primary-500 to-primary-400 rounded-full transition-all duration-500"
            style={`width: ${((currentIndex + 1) / totalPages) * 100}%`}
          ></div>
        </div>
      </div>
    )}

    <div class="px-4 py-4 space-y-6">
      {sections.map(section => (
        <div>
          <div class="flex items-center gap-2 px-2 mb-2.5">
            {section.icon === 'rocket' && (
              <svg class="w-3.5 h-3.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            )}
            {section.icon === 'cube' && (
              <svg class="w-3.5 h-3.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            )}
            {section.icon === 'bolt' && (
              <svg class="w-3.5 h-3.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            )}
            {section.icon === 'book' && (
              <svg class="w-3.5 h-3.5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            )}
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500">
              {section.title}
            </h3>
          </div>
          <ul class="space-y-0.5">
            {section.links.map(link => {
              const isActive = currentPath === link.href;
              const linkIndex = allPages.indexOf(link.href);
              const isCompleted = linkIndex < currentIndex;
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "group flex items-center gap-2.5 py-2 px-3 text-sm transition-all rounded-lg",
                      isActive
                        ? "bg-primary-50 dark:bg-primary-900/30 text-gray-900 dark:text-gray-100 font-semibold shadow-sm border border-primary-200/50 dark:border-primary-800/50"
                        : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-800/50"
                    ]}
                  >
                    <span class:list={[
                      "flex-shrink-0 w-1.5 h-1.5 rounded-full transition-all",
                      isActive
                        ? "bg-primary-500 ring-4 ring-primary-100 dark:ring-primary-900/50"
                        : isCompleted
                          ? "bg-primary-400/60"
                          : "bg-gray-300 dark:bg-gray-600"
                    ]}></span>
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <!-- Version badge -->
    <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-800">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 tracking-wide">v1.0</span>
        <span class="text-[10px] text-gray-400 dark:text-gray-500">Latest</span>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu Toggle (shown on mobile) -->
  <button
    id="mobile-docs-toggle"
    class="lg:hidden fixed bottom-6 right-6 z-50 p-4 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-full shadow-lg"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
</aside>

<!-- Mobile Sidebar Overlay -->
<div id="mobile-docs-sidebar" class="lg:hidden fixed inset-0 bg-black/50 z-40 hidden">
  <div class="absolute right-0 top-0 bottom-0 w-72 bg-white dark:bg-gray-900 p-6 overflow-y-auto shadow-2xl">
    <button id="close-mobile-docs" class="absolute top-4 right-4 text-gray-600 dark:text-gray-400">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <nav class="space-y-8 mt-12">
      {sections.map(section => (
        <div>
          <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3 px-2">
            {section.title}
          </h3>
          <ul class="space-y-1">
            {section.links.map(link => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "block py-2 px-3 text-sm transition-colors rounded-lg",
                    currentPath === link.href
                      ? "bg-primary-50 dark:bg-primary-900/30 text-gray-900 dark:text-gray-100 font-semibold"
                      : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100"
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</div>

<script>
  const toggle = document.getElementById('mobile-docs-toggle');
  const sidebar = document.getElementById('mobile-docs-sidebar');
  const close = document.getElementById('close-mobile-docs');

  toggle?.addEventListener('click', () => {
    sidebar?.classList.remove('hidden');
  });

  close?.addEventListener('click', () => {
    sidebar?.classList.add('hidden');
  });

  sidebar?.addEventListener('click', (e) => {
    if (e.target === sidebar) {
      sidebar.classList.add('hidden');
    }
  });
</script>
