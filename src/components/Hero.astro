---
---

<section class="min-h-[90vh] flex items-center justify-center px-4 py-20 pt-28 relative overflow-hidden">
  <!-- Ambient background -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-primary-200/15 dark:bg-primary-700/8 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-1/4 -right-40 w-[500px] h-[500px] bg-accent-200/15 dark:bg-accent-700/8 rounded-full blur-[100px]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-highlight-200/10 dark:bg-highlight-700/5 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-5xl mx-auto text-center relative z-10">
    <!-- Logo -->
    <div class="mb-10 flex justify-center">
      <div class="relative">
        <img
          src="/icon.png"
          alt="SaveTokens"
          class="w-20 h-20 rounded-2xl dark:brightness-90 relative z-10"
        />
        <div class="absolute -inset-3 bg-gradient-to-br from-primary-400/20 via-accent-400/10 to-highlight-400/20 rounded-3xl blur-xl"></div>
      </div>
    </div>

    <!-- Headline -->
    <h1 class="text-[3.25rem] md:text-[4.5rem] lg:text-[5rem] font-bold leading-[1.08] tracking-tight mb-6">
      <span class="text-gray-900 dark:text-gray-100">Better, Faster</span>
      <br />
      <span class="bg-gradient-to-r from-primary-600 via-accent-500 to-highlight-600 dark:from-primary-400 dark:via-accent-400 dark:to-highlight-400 bg-clip-text text-transparent">Communication with AI</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-lg md:text-xl text-gray-500 dark:text-gray-400 mb-12 max-w-2xl mx-auto leading-relaxed font-light">
      We build open-source tools that maximize the signal in every AI interaction. More context,
      less noise, faster responses, and sharper results.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-20">
      <a
        href="#products"
        class="group px-7 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-semibold text-[15px] hover:bg-gray-800 dark:hover:bg-gray-100 transition-all duration-200 shadow-lg shadow-gray-900/10 dark:shadow-black/20 hover:shadow-xl hover:-translate-y-0.5 flex items-center gap-2"
      >
        See Our Projects
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <a
        href="#mission"
        class="px-7 py-3.5 text-gray-600 dark:text-gray-300 font-medium text-[15px] hover:text-gray-900 dark:hover:text-gray-100 transition-colors flex items-center gap-2"
      >
        Our Mission
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>

    <!-- Trust strip -->
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[13px] text-gray-400 dark:text-gray-500">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        Open Source
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        MIT Licensed
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        Production Ready
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        Community Driven
      </span>
    </div>
  </div>
</section>
