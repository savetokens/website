---
const currentPath = Astro.url.pathname;
const isDocsPage = currentPath.startsWith('/axon/docs');
const isAxonPage = currentPath === '/axon' || currentPath === '/axon/';
---

<nav class="fixed top-0 left-0 right-0 z-40 bg-white/70 dark:bg-gray-950/70 backdrop-blur-xl border-b border-gray-100/80 dark:border-gray-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-[60px]">
      <!-- Logo/Brand -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="relative">
          <img src="/icon.png" alt="SaveTokens" class="w-7 h-7 rounded-lg dark:brightness-90 transition-transform duration-300 group-hover:scale-110" />
        </div>
        <span class="font-semibold text-[15px] tracking-tight text-gray-900 dark:text-gray-100">SaveTokens</span>
      </a>

      <!-- Navigation Links -->
      <div class="flex items-center gap-0.5">
        <a
          href="/"
          class:list={[
            "px-3 py-1.5 text-[13px] font-medium rounded-lg transition-all duration-200",
            currentPath === "/"
              ? "text-gray-900 dark:text-gray-100 bg-gray-100/80 dark:bg-gray-800/80"
              : "text-gray-500 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800/40"
          ]}
        >
          Home
        </a>
        <a
          href="/axon"
          class:list={[
            "px-3 py-1.5 text-[13px] font-medium rounded-lg transition-all duration-200",
            isAxonPage
              ? "text-gray-900 dark:text-gray-100 bg-gray-100/80 dark:bg-gray-800/80"
              : "text-gray-500 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800/40"
          ]}
        >
          AXON
        </a>
        <a
          href="/axon/docs"
          class:list={[
            "px-3 py-1.5 text-[13px] font-medium rounded-lg transition-all duration-200",
            isDocsPage
              ? "text-gray-900 dark:text-gray-100 bg-gray-100/80 dark:bg-gray-800/80"
              : "text-gray-500 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800/40"
          ]}
        >
          Docs
        </a>

        <!-- Separator -->
        <div class="w-px h-4 bg-gray-200 dark:bg-gray-700 mx-1.5"></div>

        <!-- GitHub -->
        <a
          href="https://github.com/savetokens"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
        </a>

        <!-- Get Started CTA -->
        <a
          href="/axon/docs/quick-start"
          class="ml-1 px-4 py-1.5 text-[13px] font-semibold bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-all duration-200"
        >
          Get Started
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Spacer -->
<div class="h-[60px]"></div>
