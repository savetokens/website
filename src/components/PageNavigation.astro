---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  prevPage?: NavLink;
  nextPage?: NavLink;
}

const { prevPage, nextPage } = Astro.props;
---

<nav class="not-prose mt-16 pt-8 border-t-2 border-gray-200 dark:border-gray-700">
  <div class="flex justify-between items-stretch gap-4">
    {prevPage ? (
      <a
        href={prevPage.href}
        class="group flex-1 flex items-center gap-3 p-5 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-primary-300 dark:hover:border-primary-700 bg-white dark:bg-gray-900 transition-all hover:shadow-md"
      >
        <svg class="w-5 h-5 text-gray-400 group-hover:text-primary-500 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mb-1">Previous</div>
          <div class="text-sm font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{prevPage.label}</div>
        </div>
      </a>
    ) : (
      <div class="flex-1"></div>
    )}

    {nextPage ? (
      <a
        href={nextPage.href}
        class="group flex-1 flex items-center justify-end gap-3 p-5 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-primary-300 dark:hover:border-primary-700 bg-white dark:bg-gray-900 transition-all hover:shadow-md text-right"
      >
        <div>
          <div class="text-xs text-gray-500 dark:text-gray-400 mb-1">Next</div>
          <div class="text-sm font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{nextPage.label}</div>
        </div>
        <svg class="w-5 h-5 text-gray-400 group-hover:text-primary-500 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    ) : (
      <div class="flex-1"></div>
    )}
  </div>
</nav>
