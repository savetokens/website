---
---

<footer class="relative py-20 px-4 bg-gray-900 dark:bg-black text-white">
  <!-- Gradient top border -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-400/40 to-transparent"></div>

  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      <!-- Brand Section -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/icon.png" alt="SaveTokens" class="w-8 h-8 rounded-lg" />
          <span class="text-lg font-bold tracking-tight">SaveTokens</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          Open-source tools that make every token count. Less waste, more meaning.
        </p>
        <a
          href="https://github.com/savetokens"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
          <span>savetokens</span>
        </a>
      </div>

      <!-- Products -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4">Products</h3>
        <ul class="space-y-3">
          <li>
            <a href="/axon" class="text-sm text-gray-300 hover:text-white transition-colors">
              AXON Format
            </a>
          </li>
          <li>
            <a href="/axon#demo" class="text-sm text-gray-300 hover:text-white transition-colors">
              Live Playground
            </a>
          </li>
          <li>
            <a
              href="https://github.com/savetokens/axon"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-300 hover:text-white transition-colors flex items-center gap-1.5"
            >
              GitHub Repository
              <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Docs -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4">Documentation</h3>
        <ul class="space-y-3">
          <li>
            <a href="/axon/docs" class="text-sm text-gray-300 hover:text-white transition-colors">
              Overview
            </a>
          </li>
          <li>
            <a href="/axon/docs/quick-start" class="text-sm text-gray-300 hover:text-white transition-colors">
              Quick Start
            </a>
          </li>
          <li>
            <a href="/axon/docs/type-system" class="text-sm text-gray-300 hover:text-white transition-colors">
              Type System
            </a>
          </li>
          <li>
            <a href="/axon/docs/examples" class="text-sm text-gray-300 hover:text-white transition-colors">
              Examples
            </a>
          </li>
        </ul>
      </div>

      <!-- More -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4">Learn More</h3>
        <ul class="space-y-3">
          <li>
            <a href="/axon/docs/compression" class="text-sm text-gray-300 hover:text-white transition-colors">
              Compression
            </a>
          </li>
          <li>
            <a href="/axon/docs/encoding-modes" class="text-sm text-gray-300 hover:text-white transition-colors">
              Encoding Modes
            </a>
          </li>
          <li>
            <a href="/axon/docs/performance" class="text-sm text-gray-300 hover:text-white transition-colors">
              Performance
            </a>
          </li>
          <li>
            <a href="/axon/docs/best-practices" class="text-sm text-gray-300 hover:text-white transition-colors">
              Best Practices
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500">
        &copy; 2025 SaveTokens. MIT Licensed.
      </p>
      <p class="text-xs text-gray-600">
        Making AI more affordable, one token at a time.
      </p>
    </div>
  </div>
</footer>
