---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="not-prose my-8 p-6 bg-highlight-50 dark:bg-highlight-900/20 rounded-xl border border-highlight-200 dark:border-highlight-800">
  <div class="flex items-center gap-2 mb-4">
    <svg class="w-5 h-5 text-highlight-600 dark:text-highlight-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
    </svg>
    <h3 class="text-sm font-bold uppercase tracking-wider text-highlight-700 dark:text-highlight-300">What You'll Learn</h3>
  </div>
  <ul class="space-y-2">
    {items.map(item => (
      <li class="flex items-start gap-2.5">
        <svg class="w-4 h-4 mt-0.5 text-highlight-500 dark:text-highlight-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span class="text-sm text-gray-700 dark:text-gray-300">{item}</span>
      </li>
    ))}
  </ul>
</div>
